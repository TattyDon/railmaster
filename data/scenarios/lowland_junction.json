      "y": 112,
      "houses": 24
    },
    {
      "name": "Corwin",
      "x": 152,
      "y": 136,
      "houses": 20
    },
    {
      "name": "Dunmore",
      "x": 196,
      "y": 96,
      "houses": 26
    }
  ],
  "medals": {
