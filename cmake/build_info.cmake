# Writes build_info.hpp naming the commit the game was built from, its date,
# and whether the working tree had uncommitted changes. Run on every build
# (see src/client/CMakeLists.txt); the header only changes when they do, so
# nothing recompiles needlessly. Without git (a source tarball) it says so.
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -P build_info.cmake
find_package(Git QUIET)
set(commit "unknown")
set(date "")
set(dirty "")
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE out RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0)
        set(commit "${out}")
        execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%cd --date=short
                        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE date
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
                        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE changes
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT changes STREQUAL "")
            set(dirty "+")
        endif()
    endif()
endif()
set(text "#pragma once
// Generated by cmake/build_info.cmake on each build: do not edit.
namespace railmaster::client {
inline constexpr const char* kBuildCommit = \"${commit}${dirty}\";
inline constexpr const char* kBuildDate = \"${date}\";
} // namespace railmaster::client
")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE ${OUTPUT} "${text}")
endif()
